@prefix :     <http://example.org/pets#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://example.org/pets> a owl:Ontology ;
    rdfs:label "Pets ontology" .

# ---- Classes ---------------------------------------------------------------
:Animal a owl:Class ; rdfs:label "Animal" ;
    rdfs:comment "Any living animal."@en , "Tout animal vivant."@fr .
:Mammal a owl:Class ; rdfs:subClassOf :Animal .
:Bird   a owl:Class ; rdfs:subClassOf :Animal .
:Fish   a owl:Class ; rdfs:subClassOf :Animal .
:Cat    a owl:Class ; rdfs:subClassOf :Mammal ; owl:disjointWith :Dog .
:Dog    a owl:Class ; rdfs:subClassOf :Mammal .
:Parrot a owl:Class ; rdfs:subClassOf :Bird .

:Person a owl:Class ; rdfs:label "Person" .
:Vet    a owl:Class ; rdfs:subClassOf :Person .
:Food   a owl:Class .
:CatFood a owl:Class ; rdfs:subClassOf :Food .

:PetOwner a owl:Class ;
    skos:definition "A person who owns at least one animal."@en ;
    owl:equivalentClass [ a owl:Restriction ; owl:onProperty :owns ; owl:someValuesFrom :Animal ] ;
    rdfs:subClassOf :Person .

:Cat rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :eats ; owl:someValuesFrom :CatFood ] .
:Dog rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasOwner ; owl:maxCardinality 1 ] .

# ---- Properties ------------------------------------------------------------
:owns a owl:ObjectProperty ; rdfs:label "owns" ;
    rdfs:domain :Person ; rdfs:range :Animal ; owl:inverseOf :hasOwner .
:hasOwner a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Animal ; rdfs:range :Person .
:eats a owl:ObjectProperty ;
    rdfs:domain :Animal ; rdfs:range :Food .
:treats a owl:ObjectProperty ;
    rdfs:domain :Vet ; rdfs:range :Animal .

:name a owl:DatatypeProperty ;
    rdfs:domain :Animal , :Person ; rdfs:range xsd:string .
:age a owl:DatatypeProperty ;
    rdfs:domain :Animal ; rdfs:range xsd:integer .
:weightKg a owl:DatatypeProperty ;
    rdfs:domain :Animal ; rdfs:range xsd:decimal .

# ---- Individuals -----------------------------------------------------------
:Feydo a owl:NamedIndividual , :Cat ;
    rdfs:label "Feydo" ;
    rdfs:comment "A very good cat, and the namesake of this tool." ;
    :name "Feydo" ; :age 16 ; :weightKg 4.2 ;
    :hasOwner :Barbara ;
    :eats :Tuna .
:Barbara a owl:NamedIndividual , :PetOwner ;
    :name "Barbara" ; :owns :Feydo .
:Rex a owl:NamedIndividual , :Dog ;
    :name "Rex" ; :age 3 ; :hasOwner :Alice .
:Alice a owl:NamedIndividual , :PetOwner ;
    :name "Alice" ; :owns :Rex , :Kiwi .
:Kiwi a owl:NamedIndividual , :Parrot ;
    :name "Kiwi" ; :age 12 ; :hasOwner :Alice .
:DrLee a owl:NamedIndividual , :Vet ;
    :name "Dr Lee" ; :treats :Feydo , :Rex .
:Tuna a owl:NamedIndividual , :CatFood .
